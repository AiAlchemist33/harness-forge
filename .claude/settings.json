{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run validate*)",
      "Bash(npm test*)",
      "Bash(node tools/validate.mjs*)",
      "Bash(node --test*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)"
    ]
  }
}
