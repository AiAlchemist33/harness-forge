# Normalize line endings: LF in the repo and in working trees on every OS.
* text=auto eol=lf

# Windows batch files must stay CRLF or cmd.exe misparses labels.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binaries
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.zip binary
*.pdf binary
*.woff binary
*.woff2 binary
